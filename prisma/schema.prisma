// 数据库连接配置
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. 用户模型 (User) - 增加身体指标，方便 AI 计算 TDEE
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  password    String?  // Hashed via bcryptjs; nullable to support future OAuth providers
  gender        String?  // 性别 (male / female)
  age           Int?     // 年龄
  weight        Float?   // 体重 (kg)
  height        Float?   // 身高 (cm)
  activityLevel String?  // sedentary / light / moderate / active
  goal          String?  // lose / maintain / gain
  targetKcal    Int      @default(2000) // 每日目标热量 (由 TDEE 算法自动计算)
  meals       Meal[]   
  createdAt   DateTime @default(now())
}

// 2. 饮食记录模型 (Meal) - 增加“三大营养素”和“识别置信度”
model Meal {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  
  foodName     String   // AI 识别出的菜名，如：红烧肉
  calories     Int      // 卡路里 (kcal)
  
  // --- 增加以下专业字段 ---
  protein      Float?   // 蛋白质 (g)
  carbs        Float?   // 碳水 (g)
  fat          Float?   // 脂肪 (g)
  portionSize  String?  // 份量描述，如 "350g" 或 "一盘"
  confidence   Float?   // AI 识别的置信度 (0-1)，体现 AI 的专业性
  
  mealType     String   // 早餐/午餐/晚餐/零食
  imageUrl     String?  // 存照片的路径
  createdAt    DateTime @default(now())
}